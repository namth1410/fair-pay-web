# Copy thành `.env.development.local` (npm run dev) và `.env.production.local` (npm run build).
# Chỉ chứa giá trị PUBLIC (URL + anon key) — anon key vốn nằm trong bundle client.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>
VITE_R2_PUBLIC_BASE_URL=https://<r2-public-domain>
VITE_GOOGLE_WEB_CLIENT_ID=<web-client-id>.apps.googleusercontent.com

# Endpoint S3 của R2 — chỉ cho proxy upload ảnh lúc dev (prod: hard-code trong deploy/nginx.conf)
R2_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
